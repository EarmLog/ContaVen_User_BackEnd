# ---- ContaVen - Backend de USUARIOS ----
# Copia este archivo como ".env" y llénalo con los datos de tu proyecto.
# El archivo ".env" NO se sube a GitHub: está en el .gitignore.

# ---- Supabase (Project Settings > API Keys) ----
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# ---- Base de datos (Project Settings > Database > Connection string) ----
# Los datos del inventario y las ventas viven en Postgres de Supabase,
# ya no en un archivo SQLite.
#
# USA EL POOLER, NO EL HOST DIRECTO. Esto no es opcional:
#   - host directo  -> db.TU_REF.supabase.co       (solo IPv6)
#   - pooler sesión -> aws-0-REGION.pooler.supabase.com  (IPv4)
# Vercel no hace IPv6 saliente, así que con el host directo la conexión
# falla en producción. El pooler además aguanta las conexiones cortas,
# que es justo como funciona una función serverless.
#
# El usuario NO es "postgres": es "postgres.TU_REF_DE_SUPABASE".
# La contraseña va codificada con urllib.parse.quote: si tiene @ : / o #
# hay que escaparlos o la conexión falla con un error difícil de leer.
DATABASE_URL=postgresql://postgres.TU_REF_DE_SUPABASE:TU_CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- App ----
PUERTO=5001
DIAS_LICENCIA_INICIAL=30
PRECIO_DOLAR_POR_DEFECTO=36.50

# ---- Servicios de terceros ----
EXCHANGERATE_API_KEY=pon_aqui_tu_llave_de_exchangerate_api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En producción esta URL tiene que ser la del backend ya desplegado,
# porque es la que Google devuelve tras autorizar.
GOOGLE_REDIRECT_URI=http://localhost:5001/api/drive/callback